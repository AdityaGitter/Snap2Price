# ==============================================================================
# ShopSmart AI – Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application
PROJECT_NAME="ShopSmart AI"
APP_ENV=development
DEBUG=True
SECRET_KEY=shopsmart_super_secure_jwt_secret_key_change_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=shopsmart_user
POSTGRES_PASSWORD=shopsmart_password_2026
POSTGRES_DB=shopsmart_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shopsmart_user:shopsmart_password_2026@postgres:5432/shopsmart_db

# Local SQLite alternative (optional fallback if running without Docker PostgreSQL):
# DATABASE_URL=sqlite:///./shopsmart.db

# Redis Caching Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# Google Gemini AI Integration (Required for Gemini 3.8 Flash Multimodal & Assistant Features)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Snap2Price External Retailer APIs (Optional - uses clearly labelled reference adapter data if unset)
AMAZON_PA_API_KEY=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
CROMA_API_KEY=
RELIANCE_API_KEY=

# Snap2Price Price-Drop Notifications: Email SMTP & AWS SNS (Optional - defaults to recorded simulation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@shopsmart.ai
AWS_REGION=ap-south-1
AWS_SNS_TOPIC_ARN=

# Background Price Monitor Interval (seconds)
PRICE_CHECK_INTERVAL_SECONDS=300
ENABLE_IN_PROCESS_PRICE_WORKER=false

# Default Seed Demo Credentials (used for initial database seeding & academic evaluation)
ADMIN_EMAIL=admin@shopsmart.ai
ADMIN_PASSWORD=Admin@123
DEMO_EMAIL=demo@shopsmart.ai
DEMO_PASSWORD=Demo@123

# Frontend URLs & CORS Origins
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:80","http://127.0.0.1:3000","http://127.0.0.1"]
VITE_API_BASE_URL=/api
